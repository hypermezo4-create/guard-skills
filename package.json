{
  "name": "mohammed-skills-universe",
  "version": "1.0.0",
  "private": true,
  "description": "Mohammed-MEZO's safety-first catalog and sync layer for the open Agent Skills ecosystem.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-skills-sh.mjs",
    "sync:trending": "node scripts/sync-skills-sh.mjs --view trending",
