{
  "name": "mohammed-skills-universe",
  "version": "2.6.0",
  "private": true,
  "description": "Mohammed-MEZO's provenance-preserving Agent Skills hub, catalog, delegation pack, imported Agent Tools library, and guarded mirror.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-dashboard.mjs",
    "sync": "node scripts/sync-skills-sh.mjs --all-views",
    "sync:all-time": "node scripts/sync-skills-sh.mjs --view all-time",
    "sync:trending": "node scripts/sync-skills-sh.mjs --view trending",
    "sync:hot": "node scripts/sync-skills-sh.mjs --view hot",
    "sync:delegate": "bash scripts/sync-delegate-skills.sh",
    "import:agent-tools": "bash scripts/rebuild-agent-tools.sh && node scripts/build-agent-tools-catalog.mjs",
    "catalog:agent-tools": "node scripts/build-agent-tools-catalog.mjs",
    "mirror": "node scripts/mirror-all-skills.mjs --prune",
    "mirror:strict": "node scripts/mirror-all-skills.mjs --prune && node scripts/verify-full-mirror.mjs",
    "mirror:no-audits": "node scripts/mirror-all-skills.mjs --prune --no-audits",
    "verify:mirror": "node scripts/verify-full-mirror.mjs",
    "find:vendored": "node scripts/find-vendored-skill.mjs",
    "install:vendored": "node scripts/install-vendored-skill.mjs",
    "validate": "npx skills add . --list --full-depth"
  },
  "dependencies": {
    "@vercel/oidc": "3.8.1"
  },
  "engines": {
    "node": "20.x"
  }
}
